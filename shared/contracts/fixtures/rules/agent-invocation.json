{
  "agents": [
    { "id": "a1", "displayName": "Reel Maker", "activation": "mention" },
    { "id": "a2", "displayName": "Reel", "activation": "mention" },
    { "id": "a3", "displayName": "Data Desk", "activation": "command" },
    { "id": "a4", "displayName": "Quiet One", "activation": "explicit" },
    { "id": "a5", "displayName": "Agent Manager", "activation": "mention" }
  ],
  "cases": [
    { "why": "the reported failure: a mention at the end", "text": "can you work under lower amount of token uses @Agent Manager", "expect": { "installId": "a5", "brief": "can you work under lower amount of token uses" } },
    { "why": "a mention at the start", "text": "@Reel Maker a 30-second teaser", "expect": { "installId": "a1", "brief": "a 30-second teaser" } },
    { "why": "the longest matching name wins", "text": "@reel maker, cut this", "expect": { "installId": "a1", "brief": "cut this" } },
    { "why": "a shorter name, case-insensitive, with a comma", "text": "@reel, cut this", "expect": { "installId": "a2", "brief": "cut this" } },
    { "why": "a mention before a question mark keeps the mark", "text": "can you cut this @Reel?", "expect": { "installId": "a2", "brief": "can you cut this?" } },
    { "why": "a mention in the middle", "text": "hey @Reel Maker, a teaser please", "expect": { "installId": "a1", "brief": "hey, a teaser please" } },
    { "why": "surrounding spaces are trimmed", "text": "  @Agent Manager   plan the launch  ", "expect": { "installId": "a5", "brief": "plan the launch" } },
    { "why": "the name must end where it ends", "text": "@Reel Maker2 hi", "expect": { "installId": "a2", "brief": "Maker2 hi" } },
    { "why": "not a mention inside a word (an address)", "text": "write to me@Reel Maker", "expect": null },
    { "why": "a command by its dashed name", "text": "/data-desk revenue by region", "expect": { "installId": "a3", "brief": "revenue by region" } },
    { "why": "a command without its dashes", "text": "/datadesk revenue", "expect": { "installId": "a3", "brief": "revenue" } },
    { "why": "a command only at the start", "text": "run /data-desk revenue", "expect": null },
    { "why": "an agent set to command doesn't answer a mention", "text": "@Data Desk revenue", "expect": null },
    { "why": "an agent set to mention answers its command too", "text": "/agent-manager what's late?", "expect": { "installId": "a5", "brief": "what's late?" } },
    { "why": "an agent set to explicit answers neither", "text": "@Quiet One do it", "expect": null },
    { "why": "nor its command", "text": "/quiet-one do it", "expect": null },
    { "why": "a call with nothing asked", "text": "@Reel Maker   ", "expect": null },
    { "why": "an ordinary message", "text": "hello there", "expect": null }
  ]
}
