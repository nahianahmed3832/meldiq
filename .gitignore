# Secrets / local config
.env
deploy/.env
deploy/livekit/livekit.yaml
android/local.properties
# Firebase client config for the owner's project (not a secret, but kept out of this public repo; docs/PUSH_FCM.md)
android/app/google-services.json
# Extra downloads of it (google-services2.json, …) and copies anywhere in the tree
google-services*.json
tools/griip-bot/bot-identity*.json
# Play upload / signing keys and their passwords: never in this (public) repository
signed_file/
*.jks
*.keystore
keystore.properties

# Build outputs
node_modules/
server/dist/
server/data/
android/.gradle/
android/build/
android/app/build/
android/.kotlin/
*.apk
*.aab
android/app/release/
!artifacts/.keep

# Python bytecode (android/i18n/gen.py)
__pycache__/
*.pyc

# OS / IDE
.DS_Store
.idea/
*.iml

# Discord reference captures: real people's names and messages, kept local only (docs/product/MELDIQ_DISCORD_REFERENCE_AUDIT.md)
research/
tools/emulator/accounts.local.json

# Database migration secrets and encrypted artifacts stay outside Git.
**/.env.redis
**/secrets/redis.acl
*.agekey
*.snapshot.age
*.ejson.gz.age
