# Merge into the existing private live environment; keep existing client/merchant/Plus/webhook IDs.
# Run paypal-live-setup.ts --live --addons before enabling, then billing-paypal-bots --publish.
PAYPAL_BOTS_PLUS_PLAN_ID=P-REPLACEWITHDISTINCTBOTSPLAN
