# Meldiq deployment configuration (formerly Orbit / Griip Message). Copy to .env (chmod 600) and fill in.
# NEVER commit .env. Generate secrets with: scripts/gen-config.sh

# ── Environment and public addresses (docs/ENVIRONMENTS.md) ──
# The new Meldiq domain isn't bought yet: keep the current hostnames until its DNS, TLS and proxy are live and the
# switch is approved (docs/MELDIQ_INFRASTRUCTURE_PLAN_2026-10-19.md). Behind your existing TLS reverse proxy.
# PUBLIC_API_URL is the API's https address (Android: meldiq.apiBaseUrl.production). LIVEKIT_PUBLIC_URL is the calls
# (wss) address the apps receive. The
# environment itself is APP_ENV (development, staging or production), set below with the account settings.
PUBLIC_API_URL=https://msg.example.com
LIVEKIT_PUBLIC_URL=wss://rtc.example.com

# ── LiveKit credentials (API key + ≥32-char secret, generated) ──
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Host ports (check for conflicts with scripts/preflight.sh first) ──
API_HOST_PORT=18080            # loopback only, reverse proxy → this
LIVEKIT_SIGNAL_HOST_PORT=17880 # loopback only, reverse proxy (wss) → this
LIVEKIT_RTC_TCP_PORT=7881      # public TCP (ICE fallback)
LIVEKIT_RTC_UDP_PORT=7882      # public UDP (media, single-port mux)
NTFY_HOST_PORT=18081           # loopback only, reverse proxy (push server name) → this; only for push wake-ups
LIVEKIT_USE_EXTERNAL_IP=true   # discover public IP via STUN; or set LIVEKIT_NODE_IP
LIVEKIT_NODE_IP=

# ── Retention (hard-capped at 7 days in code) ──
QUEUE_TTL_SECONDS=604800
ATTACHMENT_TTL_SECONDS=604800
# Orbit 2.0 file limit: bytes of the person's file before encryption (1 GiB = 1073741824). Apps check it exactly.
FILE_MAX_BYTES=1073741824
# Ciphertext per file. Leave unset to use FILE_MAX_BYTES + 1 MiB (encryption overhead). With S3 the app uploads
# straight to the bucket; uploads through this server (disk storage) need the reverse proxy to allow bodies this large
# (nginx: client_max_body_size and proxy_request_buffering off). 1 GiB per file is the only file limit (owner's
# decision 2026-10-18, UI-003): the upload quotas below are 0 (no limit). Don't pin ATTACHMENT_MAX_BYTES lower
# (production ran it at 25 MiB until UI-003).
# ATTACHMENT_MAX_BYTES=1074790400
# How long a direct upload may take before it counts as abandoned (default 24 h).
# DIRECT_UPLOAD_SESSION_SECONDS=86400

# ── Registration (T1.6) ──
# invite (default): new accounts need a registration invite (admin.js reg-invite) or an org invite code.
# open: anyone who can reach the server may register. Don't use on the shared production VPS.
REGISTRATION_MODE=invite

# ── Orbit 2.0 accounts (docs/ORBIT_2_ARCHITECTURE_2026-10-18.md §9) ──
# development, staging or production. Production refuses MAIL_TRANSPORT=file and weak password hashing.
APP_ENV=production
# How verification and password-reset codes are sent: none (sign-up answers 503), file (development only), ses or
# smtp (any SMTP provider; Hostinger Mail for development and early testing, docs/EMAIL.md).
MAIL_TRANSPORT=none
# The sender, e.g. "Meldiq <no-reply@example.com>" (quote it). For ses it must be verified in Amazon SES; for smtp it
# must be the SMTP account's own mailbox (or one it may send as). Or set MAIL_FROM_NAME and MAIL_FROM_ADDRESS instead.
MAIL_FROM=
# MAIL_FROM_NAME=Meldiq
# MAIL_FROM_ADDRESS=
# For smtp: the provider's values, exactly as its control panel shows them (placeholders only, never commit real ones).
# SMTP_HOST=
# SMTP_PORT=465          # 465: TLS from the start; another port (587) requires STARTTLS. Plain text is never used.
# SMTP_SECURE=           # true/false; defaults to true on port 465
# SMTP_USER=
# SMTP_PASS=
# SES_REGION=ap-southeast-1
# Credentials for SES: leave both unset to use the AWS default chain; never the root account's keys.
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# PASSWORD_SCRYPT_LOG_N=15         # scrypt cost (production needs 15 or more)
# ACCESS_TOKEN_TTL_SECONDS=900     # access token lifetime (60-3600)
# REFRESH_TOKEN_IDLE_DAYS=60       # a session unused this long ends
# SESSION_MAX_DAYS=180             # a session ends after this long whatever happens
# AUTH_RATE_LIMIT_PER_MINUTE=20    # unauthenticated account requests per network per minute (renewals: 10x)
# ACCOUNT_EMAILS_PER_NETWORK_PER_HOUR=30  # verification, reset and notice emails one network may cause
# The migration window for apps before 2.0. Turn registration off once the 2.0 app ships, then migration and login
# at the date the owner sets (docs/ORBIT_2_ARCHITECTURE §5).
LEGACY_REGISTRATION=on
LEGACY_LOGIN=on
LEGACY_MIGRATION=on
# on: an updated (2.0) app must move the account before it opens, with no "Later". Apps from before 2.0 keep signing in
# while LEGACY_LOGIN is on, so nobody is locked out before the update reaches them. Needs LEGACY_MIGRATION=on and working
# email (MAIL_TRANSPORT=ses or smtp), since the move ends with an emailed code.
LEGACY_MIGRATION_REQUIRED=off

# ── Abuse controls (2026-10-17, docs/ABUSE_CONTROLS.md). 0 turns a limit off. ──
# Open registration only: accounts created per network (IPv4 address or IPv6 /64) and on the whole server in 24 h.
# Registrations with an invitation code aren't counted.
REGISTRATION_PER_ADDRESS_PER_HOUR=10
REGISTRATION_PER_ADDRESS_PER_DAY=30
REGISTRATION_OPEN_PER_DAY=200
# Accounts made by open registration have smaller allowances for this many days, until they accept an invitation from
# an established member or an administrator runs `admin.js limits-end <username>`. Existing accounts are unaffected.
NEW_ACCOUNT_LIMIT_DAYS=7
# File uploads: no new-account limits (0), owner's decision 2026-10-18 (UI-003). History keeps its own limit.
NEW_ACCOUNT_DAILY_UPLOAD_BYTES=0
NEW_ACCOUNT_STORED_BYTES=0
NEW_ACCOUNTS_TOTAL_STORED_BYTES=0
NEW_ACCOUNT_HISTORY_BYTES=67108864           # 64 MiB of encrypted history per new account
# Files stored in one workspace's conversations, kept files and uploads in progress included (0: no workspace cap).
ATTACHMENT_ORG_STORED_BYTES=0
# Uploads one person may start in an hour, finished, failed or cancelled (0: no limit, since UI-003).
ATTACHMENT_UPLOAD_STARTS_PER_HOUR=0
# Devices per account at once; removed devices don't count. Raise it (and restart) if someone needs more.
MAX_DEVICES_PER_USER=20
# Realtime frames per connection (steady rate and burst) and connections per device (a newer one replaces the oldest).
WS_FRAMES_PER_SECOND=20
WS_FRAME_BURST=100
WS_MAX_SOCKETS_PER_DEVICE=4
# Every account's encrypted history together: it lives in the database on this disk.
HISTORY_TOTAL_BYTES=10737418240              # 10 GiB

# ── @everyone in groups and channels (docs/MENTIONS.md) ──
# Group admins and channel managers may always mention everyone. Other members only in conversations with at most this
# many members (0: admins and managers only). Each person: at most MENTION_ALL_PER_HOUR @everyone messages per
# conversation per hour.
MENTION_ALL_MEMBER_LIMIT=10
MENTION_ALL_PER_HOUR=5

# ── Upload quotas (bytes; 0: no limit) ──
# Owner's decision 2026-10-18 (UI-003): 1 GiB per file and no other upload limits. With STORAGE_BACKEND=local, files
# fill this VPS's disk with nothing to stop them: watch `deploy/scripts/verify.sh` (it warns below 5 GB free), or set
# ATTACHMENT_TOTAL_BYTES if the disk needs protecting. With S3 the bucket holds the files.
ATTACHMENT_USER_DAILY_BYTES=0
ATTACHMENT_USER_STORED_BYTES=0
ATTACHMENT_TOTAL_BYTES=0
ATTACHMENT_MAX_CONCURRENT_PER_USER=2
ATTACHMENT_MAX_CONCURRENT=8
# Uploads streamed through this server at once (its temporary disk). The server never uses less than two files of the
# largest size; 200 MiB here used to refuse every file over 200 MiB sent through the server.
# ATTACHMENT_MAX_PENDING_BYTES=

# ── Encrypted message history and kept files (2026-10-17, docs/MESSAGE_HISTORY.md) ──
# Each account's phones store their messages here, encrypted with a key derived from the account's identity key: the
# server can't read them, and a new phone restored with the recovery key gets them back. false: history stays only on
# phones (as before). The history API takes request bodies up to 6 MiB (the proxy limit above allows that).
HISTORY_ENABLED=true
HISTORY_MAX_ITEMS_PER_USER=500000
HISTORY_MAX_BYTES_PER_USER=1073741824        # 1 GiB of encrypted history per account
# Files in kept history stay this many days after the last request to keep them (0: never beyond the 7-day relay
# window), counted against the uploader's own quota for kept files.
ATTACHMENT_KEEP_DAYS=365
ATTACHMENT_USER_KEPT_BYTES=0                 # kept files per uploader (0: no limit, since UI-003)

# ── MongoDB (2026-10-19, docs/MONGODB.md) ──
# Unset: every table stays in SQLite, as before. MONGODB_DOMAINS lists the data whose home is MongoDB (accounts,
# preferences); move a domain only with `node dist/admin.js mongo-migrate <domain> --yes` during a write freeze, after
# backups. Production: TLS (mongodb+srv:// or tls=true), a readWrite user for this database only, network access from
# this server only. The URI holds the password: write it here with chmod 600, never in Git or chat.
# MONGODB_URI=
# MONGODB_DB=meldiq          # the default since the Meldiq rebrand; a database made earlier as "orbit" keeps its name: set it here
# MONGODB_DOMAINS=
# MONGODB_MAX_POOL=20
# MONGODB_TIMEOUT_MS=5000

# ── Platform administration and limits ──
# Apps and integrations, AI and the Unified Inbox were removed in the community rebuild
# (docs/COMMUNITY_REBUILD_2026-10-21.md): their INTEGRATIONS_*, provider OAuth, AI_*, META_*, INSTAGRAM_*, TIKTOK_* and
# INBOX_* settings are no longer read. Delete them and their secret files from the server once this version is live.
# PLATFORM_ADMIN_USER_IDS=                             # user ids that see Service health, usage and experiments

# ── Platform Admin Console (2026-10-23, docs/PLATFORM_ADMIN_CONSOLE.md) ──
# Unset: no /admin/v1 routes at all. Its admins are granted with `node dist/admin.js platform-admin-grant` (roles in
# platform_admins), not PLATFORM_ADMIN_USER_IDS. No secrets here: console sessions are random tokens stored hashed.
# ADMIN_CONSOLE_ORIGIN=https://admin.meldiq.app       # the console's origin; also its passkeys' relying party
# ADMIN_SESSION_IDLE_MINUTES=15                        # 5-60
# ADMIN_SESSION_MAX_HOURS=8                            # 1-12
# ADMIN_REAUTH_MINUTES=5                               # 1-15: how recent a passkey check must be for sensitive actions
# ADMIN_ALLOWED_NETWORKS=                              # optional CIDR list (e.g. a VPN's range); unset: any network
# ENTITLEMENT_LIMITS=                                  # optional server-wide limits: roles.custom, members, storage.bytes (docs/PLANS.md)
# BILLING_PROVIDER=none                                # none (default: nothing can be bought) | sandbox (test mode only; docs/BILLING.md)
# BILLING_SANDBOX_WEBHOOK_SECRET=                      # with sandbox: at least 32 characters (openssl rand -hex 32); never commit it
# Stripe (BILLING_PROVIDER=stripe, docs/BILLING.md › Stripe). Test keys only until live billing is approved.
# STRIPE_SECRET_KEY=                                   # sk_test_… or a restricted rk_test_… key; never commit it
# STRIPE_WEBHOOK_SECRET=                               # whsec_… of the endpoint https://<api>/v1/billing/webhooks/stripe
# BILLING_RETURN_URL=https://meldiq.app/account/billing # where Checkout and the portal send people back (fixed; no query)
# STRIPE_ALLOW_PROMOTION_CODES=false                   # true: Checkout shows a promotion code field
# BILLING_ALLOW_LIVE=false                             # true (with APP_ENV=production) is required before a live key is accepted
# STRIPE_PORTAL_CONFIGURATION=                         # bpc_…: written by scripts/stripe-setup-remote.sh
# Meldiq Mojo free periods (docs/BILLING.md › Trials and invite links). Unset BILLING_TRIAL_STARTS_AT: no trials.
# BILLING_TRIAL_STARTS_AT=2026-11-01T00:00:00Z
# BILLING_TRIAL_PLAN=plus
# BILLING_TRIAL_DAYS=14
# BILLING_REFERRAL_DAYS=30
# BILLING_REFERRAL_YEARLY_CAP_DAYS=90
# BILLING_REFERRAL_CLAIM_DAYS=7

# ── Platform Admin 2.0 (2026-10-24, meldiq_central_admin/docs/ADMIN_2_ASSESSMENT.md) ──
# PLATFORM_SECRETS_KEY: encrypts credentials the console stores (AI provider keys) with AES-256-GCM. 32 random bytes,
# hex: `openssl rand -hex 32`. A secret: chmod 600, never in Git. Unset: the console can't store credentials (it says
# so). Losing it makes stored AI keys unreadable (enter them again); changing it does the same.
# PLATFORM_SECRETS_KEY=
# HOST_METRICS_FILE: the host collector's output, mounted read-only (deploy/scripts/host-metrics.py and
# deploy/systemd/meldiq-host-metrics.*; compose.yaml mounts ./host-metrics at /host-metrics). Unset: no host network
# or per-service figures (the console lists them as not installed).
# HOST_METRICS_FILE=/host-metrics/metrics.json
# TELEMETRY_TICK_MS=60000                              # how often activity, presence and resources are written (ms)

# ── Where files are stored (2026-10-17, docs/STORAGE_AND_DATA.md, docs/AWS_STORAGE_PLAN.md) ──
# local (default): /data/attachments and /data/profile-photos in the data volume, as before.
# s3: a private Amazon S3 bucket (deploy/aws/orbit-storage.yaml creates it and a least-privilege IAM user). Apps then
# upload encrypted files straight to S3 with short-lived presigned URLs the server issues after its checks, and
# download them the same way. Credentials stay on this server, never in the app or in Git: either the IAM user's key
# (S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY, written here by the setup, chmod 600), or nothing here and the AWS SDK's
# default chain (AWS_PROFILE with a credential_process, e.g. IAM Roles Anywhere). Never the AWS root user.
# Switching doesn't move files: set STORAGE_READ_FALLBACK to the previous backend (local when moving to s3, s3 when going
# back to local) so files stored before the switch stay readable until they expire; new files go to STORAGE_BACKEND.
STORAGE_BACKEND=local
# STORAGE_READ_FALLBACK=
# Existing bucket and key prefix keep their names after the rebrand: renaming either would hide the files already
# stored (a new bucket means a planned copy, docs/MELDIQ_INFRASTRUCTURE_PLAN_2026-10-19.md).
# S3_BUCKET=griipbuddy-orbit-media-sg
# S3_REGION=ap-southeast-1
# S3_PREFIX=orbit/
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SSE=AES256                  # AES256 (S3-managed keys), aws:kms (with S3_KMS_KEY_ID), or none
# S3_KMS_KEY_ID=
# S3_PRESIGNED_DOWNLOADS=true    # false: downloads stream through this server instead of 5-minute S3 links
# S3_PRESIGN_TTL_SECONDS=300     # download links
# S3_UPLOAD_URL_TTL_SECONDS=900  # upload links (an upload must start before this; it may take longer to finish)
# S3_MULTIPART_THRESHOLD=67108864  # files over 64 MiB go in parts…
# S3_PART_SIZE=16777216            # …of 16 MiB (minimum 5 MiB)
# DIRECT_UPLOAD_SESSION_SECONDS=21600   # an upload not completed within 6 h is abandoned and its bytes removed
# DIRECT_UPLOAD_MAX_PENDING_PER_USER=10
# S3_ENDPOINT=                   # only for S3-compatible stores
# S3_FORCE_PATH_STYLE=false

# ── Federation (optional; docs/FEDERATION_PROTOCOL.md, docs/SELF_HOSTING.md §12) ──
# Leave FEDERATION_DOMAIN empty to run a standalone server. Set it to join the Griip network: users get addresses
# @name:<domain> and can talk to people on other federated servers. The server's identity key is created in
# /data/federation on first start; it's in backups (scripts/backup.sh) and must never be lost.
FEDERATION_DOMAIN=
FEDERATION_PUBLIC_URL=            # https://<domain>, as other servers and core nodes reach this server
FEDERATION_CORE_NODES=            # url#publicKey,url#publicKey,… (from the network's operators)
FEDERATION_CORE_QUORUM=           # default: a majority of FEDERATION_CORE_NODES
FEDERATION_POLICY=open            # open, or allowlist (only FEDERATION_ALLOWLIST server ids or domains)
FEDERATION_ALLOWLIST=

# ── Push wake-ups (optional, 2026-10-17; docs/BACKGROUND_DELIVERY.md, docs/SECURITY.md §7c) ──
# Off while empty. Set to the host name of YOUR OWN ntfy server (UnifiedPush) to let phones opt in: when something is
# queued for a phone with no open connection, the server sends its endpoint an empty HTTPS request that only wakes the
# app; nothing about the message is sent. Only these hosts are ever contacted (https, public addresses only, no
# redirects). host:port only for a port other than 443. Needs the ntfy service (compose.yaml, ntfy/server.yml), its DNS
# name and TLS route first, and this host must reach its own public address on 443 (docs/PUSH_SERVER.md).
PUSH_UNIFIEDPUSH_HOSTS=
# PUSH_WAKE_INTERVAL_SECONDS=30  # at most one wake-up per phone in this window (5-600); a ring waits at most 5 s
# PUSH_TIMEOUT_MS=5000           # deadline per wake-up request (1000-15000)

# ── Firebase Cloud Messaging wake-ups (optional, round 6; docs/PUSH_FCM.md) ──
# Off while unset. A second way to wake phones (data-only, nothing about the message is sent). Needs a Firebase project
# and a service-account key FILE kept out of the repository, readable by the API container (mount it read-only).
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# FCM_WAKE_INTERVAL_SECONDS=30   # at most one ordinary wake-up per phone in this window (5-3600); rings and reminders don't wait

# ── Reminders (round 6; docs/REMINDERS.md) ──
# REMINDER_TICK_MS=15000          # how often due reminders are fired (0 turns the loop off; at most 300000)

# ── Instance (optional) ──
# Shown on the app's server check and setup screens; up to 80 characters.
# Quote a name with spaces (scripts read this file with the shell): INSTANCE_NAME="Example Community"
INSTANCE_NAME=

LOG_LEVEL=info

# ── Passkeys (docs/PASSKEYS.md) ──
# The host people reach this server at (no scheme). Unset: passkeys are off and the apps hide them.
# PASSKEY_RP_ID=msg.example.com
# Android apps that may use them: package=SHA-256 signing-certificate fingerprint (keytool -list -v), comma-separated.
# PASSKEY_ANDROID_APPS=com.meldiq.android=AA:BB:…,com.meldiq.android.test=AA:BB:…
# Web apps on other hosts (each origin's host is its own relying party), comma-separated: https only (http://localhost for
# development). Production: https://web.meldiq.app
# PASSKEY_WEB_ORIGINS=https://web.example.com
