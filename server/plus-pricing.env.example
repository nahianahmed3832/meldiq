# Backend-only candidate configuration. Do not copy Sandbox IDs into live settings.
# Preserve the original PayPal plan versions in the existing billing catalog for historical renewals.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# New resources prepared by paypal-plus-v2-setup.ts; no existing plan is repriced.
PAYPAL_PLUS_V2_PRODUCT_ID=
PAYPAL_PLUS_V2_PLAN_ID=
PAYPAL_PLUS_V2_QUARTERLY_PLAN_ID=
PAYPAL_PLUS_V2_YEARLY_PLAN_ID=
# Set these to the reviewed v2 resources only at the separately approved publication step.
PAYPAL_PLUS_PRODUCT_ID=
PAYPAL_PLUS_PLAN_ID=
PAYPAL_PLUS_QUARTERLY_PLAN_ID=
PAYPAL_PLUS_YEARLY_PLAN_ID=
PAYPAL_SUBSCRIPTIONS_APPROVED=false
# Existing unrelated product switches/IDs retain their current values.
# BILLING_PROVIDER, BILLING_ALLOW_LIVE and APP_ENV are not enabled by this file.
