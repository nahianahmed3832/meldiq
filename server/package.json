{
  "name": "meldiq-server",
  "version": "0.42.0",
  "private": true,
  "description": "Meldiq relay/API server (internal beta)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "admin": "node dist/admin.js",
    "seed:dev": "node dist/seed.js",
    "contracts": "tsx scripts/contracts.ts"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/client-sesv2": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/websocket": "11.3.4",
    "@simplewebauthn/server": "14.0.2",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "livekit-server-sdk": "2.19.1",
    "mongodb": "7.7.0",
    "nodemailer": "10.0.14",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "mongodb-memory-server": "11.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "ws": "8.22.0"
  }
}
