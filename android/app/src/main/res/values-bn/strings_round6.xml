    <string name="sec_messages">মেসেজ Meldiq-এর সার্ভারে রাখা হয়</string>
    <string name="sec_messages_body">মেসেজ, রিঅ্যাকশন, পোল আর এডিট Meldiq-এর সার্ভারে রাখা হয় এবং এনক্রিপ্টেড সংযোগে (TLS) আসা-যাওয়া করে। এই কথোপকথনের সদস্যরা পড়তে পারেন, আর রিপোর্ট বা আইনের প্রয়োজনে Meldiq-এর কর্মীরাও পারেন।</string>
    <string name="sec_files">ফাইল আপলোডের আগেই এনক্রিপ্ট হয়</string>
    <string name="sec_files_body">ছবি, ভিডিও, ভয়েস মেসেজ আর ফাইল এই কথোপকথনের সদস্যদের জন্য Meldiq-এর সার্ভারে রাখা হয়। Meldiq এগুলোতে ভাইরাস স্ক্যান করে না।</string>
    <string name="sec_calls_e2ee">কল এন্ড-টু-এন্ড এনক্রিপ্টেড</string>
    <string name="sec_calls_e2ee_body">কলের অডিও ও ভিডিও এমন কী ব্যবহার করে যা শুধু অংশগ্রহণকারীদের কাছে আছে। মিডিয়া ডিক্রিপ্ট হতে শুরু করলে কল স্ক্রিন তা নিশ্চিত করে।</string>
    <string name="sec_calls_transport">কল শুধু পথে এনক্রিপ্টেড</string>
    <string name="sec_calls_transport_body">এই ফোনে কলের এন্ড-টু-এন্ড এনক্রিপশন বন্ধ (সেটিংস › কল), তাই Meldiq-এর মিডিয়া সার্ভার কলের অডিও ও ভিডিও পেতে পারে।</string>
    <string name="sec_verified">যাচাই করা হয়েছে</string>
    <string name="sec_verified_body">আপনি %1$s-এর সঙ্গে নিরাপত্তা নম্বর মিলিয়েছেন। তাঁর কী বদলালে Meldiq বার্তা থামিয়ে আপনাকে জানাবে।</string>
