# Griip Message deployment configuration. Copy to .env (chmod 600) and fill in.
# NEVER commit .env. Generate secrets with: scripts/gen-config.sh

# ── Public URLs the Android app uses (behind your existing TLS reverse proxy) ──
PUBLIC_API_URL=https://msg.example.com
LIVEKIT_PUBLIC_URL=wss://rtc.example.com

# ── LiveKit credentials (API key + ≥32-char secret, generated) ──
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Host ports (check for conflicts with scripts/preflight.sh first) ──
API_HOST_PORT=18080            # loopback only, reverse proxy → this
LIVEKIT_SIGNAL_HOST_PORT=17880 # loopback only, reverse proxy (wss) → this
LIVEKIT_RTC_TCP_PORT=7881      # public TCP (ICE fallback)
LIVEKIT_RTC_UDP_PORT=7882      # public UDP (media, single-port mux)
LIVEKIT_USE_EXTERNAL_IP=true   # discover public IP via STUN; or set LIVEKIT_NODE_IP
LIVEKIT_NODE_IP=

# ── Retention (hard-capped at 7 days in code) ──
QUEUE_TTL_SECONDS=604800
ATTACHMENT_TTL_SECONDS=604800
ATTACHMENT_MAX_BYTES=26214400

LOG_LEVEL=info

# Unified database migration (backend only; never use public frontend environment variables).
# Switch only after every domain is copied/verified and authority markers exist.
DATABASE_MODE=hybrid
# Full target: accounts,preferences,history,reports,relationships,relay,files,calls,workspace,conversations,billing,safety,platform,federation,ephemeral,identity
# REDIS_URL=rediss://meldiq@redis.example.invalid:6379/0
# REDIS_PASSWORD=replace-through-secret-storage
REDIS_KEY_PREFIX=meldiq:production:v1
REDIS_TIMEOUT_MS=1000
MELDIQ_NODE_OPTIONS=--max-old-space-size=384
# true ONLY on an isolated, unexposed private network (the provided Compose overlay).
REDIS_PRIVATE_NETWORK=false
